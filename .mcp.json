{
  "mcpServers": {
    "foundry-image": {
      "type": "stdio",
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/server/server.mjs"],
      "env": {
        "MAI_IMAGE_ENDPOINT": "${MAI_IMAGE_ENDPOINT:-}",
        "MAI_IMAGE_DEPLOYMENT": "${MAI_IMAGE_DEPLOYMENT:-}",
        "MAI_IMAGE_API_KEY": "${MAI_IMAGE_API_KEY:-}",
        "MAI_IMAGE_OUTPUT_DIR": "${MAI_IMAGE_OUTPUT_DIR:-}",
        "GPT_IMAGE_ENDPOINT": "${GPT_IMAGE_ENDPOINT:-}",
        "GPT_IMAGE_DEPLOYMENT": "${GPT_IMAGE_DEPLOYMENT:-}",
        "GPT_IMAGE_API_KEY": "${GPT_IMAGE_API_KEY:-}",
        "GPT_IMAGE_API_VERSION": "${GPT_IMAGE_API_VERSION:-}",
        "IMAGE_DEFAULT_MODEL": "${IMAGE_DEFAULT_MODEL:-}",
        "FOUNDRY_IMAGE_ENV_FILE": "${FOUNDRY_IMAGE_ENV_FILE:-}"
      }
    }
  }
}
